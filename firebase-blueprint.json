{
  "entities": {
    "Job": {
      "title": "Job Posting",
      "description": "Details of a job opening",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "department": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["open", "closed", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "description", "status", "createdAt", "createdBy"]
    },
    "Candidate": {
      "title": "Candidate Profile",
      "description": "Information about a candidate extracted from resume",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "array", "items": { "type": "object" } },
        "education": { "type": "array", "items": { "type": "object" } },
        "resumeText": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["fullName", "email", "userId"]
    },
    "Application": {
      "title": "Job Application",
      "description": "A candidate's application for a specific job",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "candidateId": { "type": "string" },
        "candidateName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "shortlisted", "rejected"] },
        "score": { "type": "number" },
        "matchAnalysis": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "strengths": { "type": "array", "items": { "type": "string" } },
            "weaknesses": { "type": "array", "items": { "type": "string" } },
            "biasCheck": { "type": "string" }
          }
        },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "candidateId", "status", "appliedAt"]
    },
    "HRAnalytics": {
      "title": "HR Analytics",
      "description": "Snapshot of recruitment performance and bias metrics",
      "type": "object",
      "properties": {
        "totalApplications": { "type": "number" },
        "averageScore": { "type": "number" },
        "biasAlerts": { "type": "number" },
        "topSkills": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of all job postings"
    },
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Private candidate profiles"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Applications linking jobs and candidates"
    },
    "/analytics/summary": {
      "schema": "HRAnalytics",
      "description": "Aggregated recruitment data"
    }
  }
}
