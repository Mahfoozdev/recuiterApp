rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Auth tokens don't have custom claims by default in this setup, 
    // so we'll assume a 'users' collection or a list of admin UIDs if needed.
    // For this app, let's treat people who can create jobs as 'HR'.
    // We'll use a simple check: if a user is in the /admins collection.
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }

    // --- Jobs ---
    match /jobs/{jobId} {
      allow read: if true; // Public for candidates
      allow create: if isAdmin() && isValidJob(request.resource.data);
      allow update: if isAdmin() && isValidJob(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidJob(data) {
      return data.keys().hasAll(['title', 'description', 'status', 'createdAt', 'createdBy'])
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 5000
        && data.status in ['open', 'closed', 'draft']
        && data.createdBy == request.auth.uid;
    }

    // --- Candidates ---
    match /candidates/{candidateId} {
      allow read, write: if isOwner(candidateId);
    }

    // --- Applications ---
    match /applications/{applicationId} {
      // HR can read all, Candidates can read their own
      allow read: if isAdmin() || (isSignedIn() && resource.data.candidateId == request.auth.uid);
      
      // Candidate can apply
      allow create: if isSignedIn() 
        && request.resource.data.candidateId == request.auth.uid
        && isValidApplication(request.resource.data);
        
      // HR can update scores and status
      allow update: if (isAdmin() || (isSignedIn() && resource.data.candidateId == request.auth.uid))
        && isValidApplicationUpdate();
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['jobId', 'candidateId', 'status', 'appliedAt'])
        && data.jobId is string && data.candidateId is string
        && data.status == 'pending'
        && data.appliedAt == request.time;
    }

    function isValidApplicationUpdate() {
      // Allow HR to update status/score/matchAnalysis
      // Allow Candidate to maybe cancel? (not implemented yet, but keeping it simple)
      return isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'score', 'matchAnalysis']);
    }

    // --- Analytics ---
    match /analytics/summary {
      allow read: if isAdmin();
      allow write: if false; // System only (simulated here)
    }

    // --- Admins ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Manually managed or bootstrap session
    }
  }
}
